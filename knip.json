{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"],
      "ignoreDependencies": ["typescript-eslint", "@typescript-eslint/eslint-plugin"]
    },
    "packages/build": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@lvce-editor/extension-management-worker",
        "@lvce-editor/preview-sandbox-worker",
        "@lvce-editor/preview-worker",
        "@lvce-editor/renderer-process"
      ],
      "entry": ["src/build-extension.ts", "src/build-static-site.ts", "src/computeNodeModulesCacheKey.ts", "src/dev.ts", "test/**/*.test.ts"]
    },
    "packages/e2e": {
      "entry": ["threejs.static-site.ts"],
      "project": ["*.ts"]
    },
    "packages/extension": {
      "entry": ["src/compilerWorker.ts", "src/demoSyncRpcClient.ts", "src/extensionMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "project": [],
      "ignoreDependencies": ["@lvce-editor/server"]
    }
  }
}
